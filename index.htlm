<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>ONIRI Production</title>
<style>
  html, body { margin:0; height:100%; background:#0a0a0a; }

  /* ===== HEADER VIDÉO ===== */
  .hero-video {
    position: relative;
    width: 100%;
    height: 100svh;          /* plein écran, adapté mobile */
    overflow: hidden;
    background: #0a0a0a;
  }
  .hero-video video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;       /* remplit tout l'écran sans déformer */
  }
  /* voile sombre léger pour lire le texte par-dessus (optionnel) */
  .hero-video::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,.25);
    pointer-events: none;
  }
  /* zone pour votre futur contenu (logo, menu, titre...) */
  .hero-content {
    position: relative;
    z-index: 2;
    height: 100%;
  }
</style>
</head>
<body>

<header class="hero-video">
  <!--
    POUR CHANGER LA VIDÉO PLUS TARD :
    remplacez uniquement les valeurs de src ci-dessous par votre URL
    (ex: https://monsite.fr/videos/hero.mp4)
  -->
  <video
    autoplay muted loop playsinline preload="auto"
    poster="videos/hero-poster.jpg">
    <source src="videos/hero-mobile.mp4" type="video/mp4" media="(max-width: 768px)">
    <source src="videos/hero.mp4" type="video/mp4">
  </video>

  <div class="hero-content">
    <!-- Ajoutez ici plus tard : logo, menu, titre... -->
  </div>
</header>

</body>
</html>
